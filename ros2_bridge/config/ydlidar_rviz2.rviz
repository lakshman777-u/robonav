      Expanded:
        - /Global Options1
        - /Status1
        - /Grid1
        - /LaserScan1
        - /LaserScan1/Status1
        - /LaserScan1/Topic1
        - /Map1
        - /Map1/Status1
        - /Map1/Topic1
        - /Map1/Update Topic1
